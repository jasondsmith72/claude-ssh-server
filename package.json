{
  "name": "claude-ssh-server",
  "license": "MIT",
  "version": "1.0.0",
  "description": "MCP server enabling direct SSH connections with IP/username/password - no config required. Fork of ssh-mcp with ad-hoc connection support.",
  "type": "module",
  "bin": {
    "claude-ssh-server": "build/index.js"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && shx chmod +x build/*.js",
    "inspect": "npx @modelcontextprotocol/inspector node build/index.js",
    "test": "cross-env SSH_MCP_DISABLE_MAIN=1 vitest --run",
    "test:watch": "cross-env SSH_MCP_DISABLE_MAIN=1 vitest",
    "coverage": "cross-env SSH_MCP_DISABLE_MAIN=1 vitest --run --coverage"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "ssh2": "^1.17.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/ssh2": "^1.15.5",
    "cross-env": "^7.0.3",
    "shx": "^0.4.0",
    "testcontainers": "^11.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "homepage": "https://github.com/jasondsmith72/claude-ssh-server#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/jasondsmith72/claude-ssh-server.git"
  },
  "bugs": {
    "url": "https://github.com/jasondsmith72/claude-ssh-server/issues"
  },
  "keywords": [
    "ssh",
    "mcp",
    "model-context-protocol",
    "server",
    "windows",
    "linux",
    "automation",
    "remote",
    "cli",
    "typescript",
    "direct-connection",
    "ad-hoc",
    "no-config",
    "claude"
  ],
  "author": "Jason Smith (jasondsmith72)",
  "engines": {
    "node": ">=18"
  }
}
